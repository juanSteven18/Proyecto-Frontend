<%- include('../partials/header') %>

<main class="menu-container" style="margin-top: 2rem;">
    <h2>Historial Exclusivo de Pedidos del Día</h2>

    <div class="resumen-grid">
        <div class="resumen-card">
            <span>Pedidos totales hoy</span>
            <strong><%= resumen.totalPedidosDia %></strong>
        </div>
        <div class="resumen-card">
            <span>Entregados</span>
            <strong><%= resumen.totalEntregados %></strong>
        </div>
        <div class="resumen-card">
            <span>Cancelados</span>
            <strong><%= resumen.totalCancelados %></strong>
        </div>
        <div class="resumen-card">
            <span>Total facturado hoy</span>
            <strong>$<%= resumen.ingresosDia.toFixed(2) %></strong>
        </div>
    </div>

    <div class="tabla-wrapper">
        <table class="tabla-historial">
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Mesa</th>
                    <th>Atendió</th>
                    <th>Hora Pedido</th>
                    <th>Hora Entrega</th>
                    <th>Estado Final</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <% pedidos.forEach(p => { %>
                    <tr>
                        <td><%= p.codigo_comprobante %></td>
                        <td><%= p.numero_mesa %></td>
                        <td><%= p.mesero_nombre %></td>
                        <td><%= new Date(p.createdAt).toLocaleString('es-VE') %></td>
                        <td><%= p.fecha_entrega ? new Date(p.fecha_entrega).toLocaleString('es-VE') : '—' %></td>
                        <td><span class="estado-badge estado-<%= p.estado %>"><%= p.estado.toUpperCase() %></span></td>
                        <td>$<%= p.total.toFixed(2) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</main>

<%- include('../partials/footer') %>