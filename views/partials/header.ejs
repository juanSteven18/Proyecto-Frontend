<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bite&Go - Pedidos Online</title>
    <link rel="stylesheet" href="/css/estilo.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="site-header">
        <div class="header-container">
            <a href="/" class="logo-marca" style="text-decoration: none;">
                <span class="logo-icon">🍔</span>
                <span class="logo-texto">Bite&<b>Go</b></span>
            </a>
            
            <div class="header-acciones" style="display: flex; align-items: center; gap: 0.75rem;">
                <% if (usuarioActual) { %>
                    <span style="font-size: 0.85rem; color: #64748b; font-weight: 600;">
                        <%= usuarioActual.nombre %> (<%= usuarioActual.rol %>)
                    </span>
                    <a href="/panel/cola" class="filtro-btn" style="text-decoration: none; padding: 0.45rem 1rem;">Cola</a>
                    
                    <% if (usuarioActual.rol === 'supervisor') { %>
                        <a href="/panel/historial" class="filtro-btn" style="text-decoration: none; padding: 0.45rem 1rem;">Historial</a>
                    <% } %>

                    <form action="/auth/logout" method="POST" style="margin: 0;">
                        <button type="submit" class="filtro-btn" style="padding: 0.45rem 0.9rem; color: #dc2626; border-color: #fecaca;">Salir</button>
                    </form>
                <% } %>

                <button id="btn-abrir-carrito" class="btn-icono-carrito" title="Ver tu pedido">
                    🛍️ <span id="contador-carrito">0</span>
                </button>
            </div>
        </div>
    </header>